# Per-fossil burial records: generated data, one dir per run. Fossil
# treats these as append-only under ~/.fossil/projects/<name>, which
# is a symlink into this tree.
/fossils-I/**/records/
/fossils-II/**/records/
/fossils/*/records/
/.last

# Python bytecode caches from analysis scripts.
__pycache__/
*.pyc

# Editor / OS junk.
*.swp
.DS_Store

# Standalone V8 checkout and build outputs.
v8-project/
/oopsla-2027/artifacts/
